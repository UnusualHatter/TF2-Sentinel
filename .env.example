POSTGRES_DB=tf2sentinel
POSTGRES_USER=tf2sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Steam Web API key, from https://steamcommunity.com/dev/apikey. Used by
# scripts/refresh_steam_profiles.py to resolve public persona names and avatars
# in bulk. In CI the same value comes from the STEAM_WEB_API_KEY repository
# secret; it is never part of anything published under docs/.
STEAM_WEB_API_KEY=

# SteamHistory API key, from https://steamhistory.net/api (log in with Steam).
# Used by scripts/fetch_steamhistory_bans.py to look up community server bans
# for accounts already in the database.
STEAMHISTORY_API_KEY=
